# Discord application (https://discord.com/developers/applications)
TOKEN=
CLIENTID=
# Server used by `npm run deploy` for instant dev command updates
GUILDID=

# MongoDB: one URI for everything...
MONGO_URI=mongodb://localhost:27017/fira
# ...or (v1 layout) a separate database per feature. Any that are set override MONGO_URI.
# MONGOURLECONOMY=mongodb://localhost:27017/economy
# MONGOURLBIRTHDAY=mongodb://localhost:27017/birthday
# MONGOURLUSERS=mongodb://localhost:27017/users
# MONGOURLTICKET=mongodb://localhost:27017/ticket
# MONGOURLCONFIG=mongodb://localhost:27017/config

# Optional
# SUPPORT_URL=https://discord.gg/your-invite
# SHARDS_PER_CLUSTER=2
