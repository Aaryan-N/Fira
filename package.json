{
 "name": "fira",
 "version": "2.0.0",
 "description": "Fira: a friendly all-round Discord bot with games, economy, birthdays, tickets and tools.",
 "type": "module",
 "main": "src/index.js",
 "private": true,
 "engines": {
  "node": ">=22.12"
 },
 "scripts": {
  "start": "node --env-file-if-exists=.env src/index.js",
  "deploy": "node --env-file-if-exists=.env scripts/deploy-commands.js",
  "deploy:global": "node --env-file-if-exists=.env scripts/deploy-commands.js --global",
  "lint": "eslint .",
  "format": "prettier --write .",
  "format:check": "prettier --check .",
  "test": "node --test",
  "check": "npm run lint && npm run format:check && npm test",
  "smoke": "node scripts/smoke.js"
 },
 "repository": {
  "type": "git",
  "url": "git+https://github.com/Aaryan-N/Fira.git"
 },
 "author": "Aaryan Narayan",
 "license": "ISC",
 "dependencies": {
  "@napi-rs/canvas": "^1.0.13",
  "chalk": "^6.0.1",
  "color-convert": "^3.1.3",
  "discord-hybrid-sharding": "^3.0.1",
  "discord.js": "^14.27.0",
  "mongoose": "^9.11.3"
 },
 "devDependencies": {
  "@eslint/js": "^10.0.1",
  "eslint": "^10.13.0",
  "globals": "^17.13.0",
  "prettier": "^3.9.10"
 }
}
